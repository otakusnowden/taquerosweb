# ── Hot Wings (demo) — URLs limpias sin extensión .php ──────────────
Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /demo/wings/

    # index.php → raíz de la carpeta (301)
    RewriteCond %{THE_REQUEST} \s/(?:[^\s]*/)?index\.php[\s?] [NC]
    RewriteRule ^ /demo/wings/ [R=301,L]

    # /pagina.php → /pagina (301, evita contenido duplicado en buscadores)
    RewriteCond %{THE_REQUEST} \s/(?:[^\s]*/)?(menu|ubicaciones|reservacion)\.php[\s?] [NC]
    RewriteRule ^ /demo/wings/%1 [R=301,L]

    # Quitar la diagonal final para que las rutas relativas sigan funcionando
    RewriteRule ^(menu|ubicaciones|reservacion)/$ /demo/wings/$1 [R=301,L]

    # URL limpia → archivo .php real (solo si no existe ya el archivo/carpeta)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(menu|ubicaciones|reservacion)$ $1.php [L]
</IfModule>
