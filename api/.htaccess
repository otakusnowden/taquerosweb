# Protección del directorio /api
# Solo permite acceso a send-order.php; bloquea navegación y acceso directo a config.php

Options -Indexes

# Bloquear acceso directo a config.php
<Files "config.php">
    Order Allow,Deny
    Deny from all
</Files>

# Solo permitir POST a send-order.php (los navegadores hacen GET en la URL; rechazarlos)
<Files "send-order.php">
    Order Allow,Deny
    Allow from all
</Files>
